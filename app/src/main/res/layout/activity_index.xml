<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3EFE2">

    <Button
        android:id="@+id/btnContinue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="متابعة القراءة"
        android:padding="14dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvIndex"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp" />

</LinearLayout>        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/rvIndex"
        app:layout_constraintBottom_toBottomOf="@id/rvIndex"
        app:layout_constraintStart_toStartOf="@id/rvIndex"
        app:layout_constraintEnd_toEndOf="@id/rvIndex"/>

</androidx.constraintlayout.widget.ConstraintLayout>
